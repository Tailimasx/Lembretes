<Window x:Class="Lembretes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lembretes" Height="450" Width="320">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Adicionar" Padding="10,4"
                    Margin="8,0,0,0" IsDefault="True" Click="BtnAdicionar_Click"/>
            <TextBox x:Name="TxtNovo" Padding="4"/>
        </DockPanel>

        <ListBox Grid.Row="1" x:Name="ListaTarefas" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0"
                                Tag="{Binding}" Click="BtnApagar_Click"/>
                        <CheckBox x:Name="chk" IsChecked="{Binding Feito}"
                                  VerticalContentAlignment="Center">
                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=chk}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>