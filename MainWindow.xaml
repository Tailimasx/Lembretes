<Window x:Class="Lembretes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lembretes" Width="404" Height="569"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="CorFundo" Color="#F0EDE4FA"/>
        <SolidColorBrush x:Key="CorBorda" Color="#D9FFFFFF"/>
        <SolidColorBrush x:Key="CorTitulo" Color="#30233F"/>
        <SolidColorBrush x:Key="CorTextoSuave" Color="#73637F"/>
        <SolidColorBrush x:Key="CorDestaque" Color="#684388"/>
        <SolidColorBrush x:Key="CorCartao" Color="#8CFFFFFF"/>
        <SolidColorBrush x:Key="CorCartaoAberto" Color="#FAF5FF"/>
        <SolidColorBrush x:Key="CorLinha" Color="#D9C9E7"/>
        <SolidColorBrush x:Key="CorCaixa" Color="#A190AE"/>
        <SolidColorBrush x:Key="CorMarcado" Color="#D2B9ED"/>

        <!-- Botão só com ícone -->
        <Style x:Key="BotaoIcone" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#22684388"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setinha de abrir/fechar subtarefas -->
        <Style x:Key="BotaoSetinha" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="&#xE70D;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="fundo" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#22684388"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xE70E;"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Caixinha de marcar arredondada -->
        <Style x:Key="CaixaMarcar" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource CorTitulo}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="caixa" Width="20" Height="20" CornerRadius="6"
                                    BorderThickness="1.5" BorderBrush="{StaticResource CorCaixa}"
                                    Background="#80FFFFFF" VerticalAlignment="Center">
                                <TextBlock x:Name="tique" Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource CorDestaque}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="caixa" Property="Background" Value="{StaticResource CorMarcado}"/>
                                <Setter TargetName="caixa" Property="BorderBrush" Value="{StaticResource CorMarcado}"/>
                                <Setter TargetName="tique" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Campo de texto arredondado -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource CorTitulo}"/>
            <Setter Property="CaretBrush" Value="{StaticResource CorDestaque}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="borda" Background="#E6FFFFFF" BorderBrush="{StaticResource CorLinha}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource CorDestaque}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Margin="12" Background="{StaticResource CorFundo}"
            BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#30233F"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent"
                  MouseLeftButtonDown="Cabecalho_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Meu dia" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource CorTitulo}"/>
                    <TextBlock x:Name="TxtData" FontSize="14" Margin="0,2,0,0"
                               Foreground="{StaticResource CorTextoSuave}"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource BotaoIcone}"
                        Content="&#xE8BB;" ToolTip="Fechar" Click="BtnFechar_Click"/>
            </Grid>

            <!-- Lista de tarefas -->
            <ListBox Grid.Row="1" x:Name="ListaTarefas" HorizontalContentAlignment="Stretch"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="14" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource CorCartao}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=tgl}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CorCartaoAberto}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource CorLinha}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="chk" Style="{StaticResource CaixaMarcar}"
                                              IsChecked="{Binding Feito}" Click="Chk_Click">
                                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chk}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>

                                    <ToggleButton x:Name="tgl" Grid.Column="1" Style="{StaticResource BotaoSetinha}"
                                                  IsChecked="{Binding Expandida}" Click="Chk_Click"
                                                  ToolTip="Mostrar/esconder subtarefas"/>
                                    <Button Grid.Column="2" Style="{StaticResource BotaoIcone}" Content="&#xE74D;"
                                            Tag="{Binding}" Click="BtnApagar_Click" ToolTip="Excluir tarefa"/>
                                </Grid>

                                <!-- Subtarefas (só aparecem com a setinha aberta) -->
                                <StackPanel Margin="32,6,0,2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=tgl}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <ItemsControl ItemsSource="{Binding Subtarefas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="chkSub" Style="{StaticResource CaixaMarcar}"
                                                              FontSize="14" IsChecked="{Binding Feito}" Click="Chk_Click">
                                                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkSub}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </CheckBox>
                                                    <Button Grid.Column="1" Style="{StaticResource BotaoIcone}"
                                                            Width="26" Height="26" FontSize="13" Content="&#xE74D;"
                                                            Tag="{Binding}" Click="BtnApagarSub_Click"
                                                            ToolTip="Excluir subtarefa"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,6,0,0">
                                        <TextBox x:Name="txtSub" Style="{StaticResource CampoTexto}"
                                                 FontSize="14" Padding="12,7" Tag="{Binding}"
                                                 KeyDown="TxtSub_KeyDown"/>
                                        <TextBlock Text="Adicionar subtarefa (Enter)" FontSize="14"
                                                   Foreground="{StaticResource CorTextoSuave}"
                                                   Margin="13,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtSub}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Campo para nova tarefa -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBox x:Name="TxtNovo" Style="{StaticResource CampoTexto}"
                         Padding="44,12,12,12" KeyDown="TxtNovo_KeyDown"/>
                <Button Style="{StaticResource BotaoIcone}" Content="&#xE710;"
                        HorizontalAlignment="Left" Margin="6,0,0,0"
                        Foreground="{StaticResource CorDestaque}"
                        Click="BtnAdicionar_Click" ToolTip="Adicionar tarefa"/>
                <TextBlock Text="Adicionar uma tarefa" FontSize="15"
                           Foreground="{StaticResource CorTextoSuave}"
                           Margin="46,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtNovo}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>